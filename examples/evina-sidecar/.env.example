# EVINA sidecar configuration — PLACEHOLDERS ONLY. Copy to .env and fill in.
# Never commit real credentials (.env is gitignored at the repo root).

# Auth mode: "v2-apikey" (default) or "v1-signature" (legacy accounts, ADR-015).
EVINA_AUTH_MODE=v2-apikey
EVINA_API_KEY=replace-with-your-evina-api-key
EVINA_USERNAME=replace-with-your-evina-username
# EVINA_PASSWORD required only when EVINA_AUTH_MODE=v1-signature.
EVINA_PASSWORD=
EVINA_BASE_URL=https://api.dcbprotect.com
EVINA_DEFAULT_COUNTRY=LK
EVINA_DEFAULT_CARRIER=41302

# Sidecar HTTP port.
PORT=5005

# Shared secret required in the X-Sidecar-Key header on every request.
# The Java caller (pin-auth) must send the same value. This keeps the sidecar
# private to your backend — it must NOT be exposed to the public internet.
SIDECAR_API_KEY=2d65572e-ba52-457d-9494-a393f73bd8f2
