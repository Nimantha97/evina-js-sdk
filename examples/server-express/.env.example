# Example app configuration — PLACEHOLDERS ONLY.
# Copy to .env and fill in your EVINA credentials.
# Never commit real credentials (NFR-SEC-11).

# This demo drives /v1/test_session (deterministic ft), which is signature-based,
# so it must run in v1-signature mode (ADR-015).
EVINA_AUTH_MODE=v1-signature
EVINA_USERNAME=replace-with-your-evina-username
EVINA_PASSWORD=replace-with-your-evina-signature-secret
EVINA_API_KEY=

EVINA_DEFAULT_COUNTRY=LK
EVINA_DEFAULT_CARRIER=41302
PORT=3000
