# EVINA credentials for the pin-auth demo — PLACEHOLDERS ONLY.
# Copy to .env and fill with your real EVINA credentials.
# Never commit real credentials (.env is gitignored at the repo root).

# --- Auth mode -------------------------------------------------------------
# "v2-apikey"    (default): POST + X-EVINA-APIKEY header. Needs EVINA_API_KEY.
# "v1-signature" (legacy):  GET /{username}/... with a signature. Needs
#                           EVINA_USERNAME + EVINA_PASSWORD. Use this for the
#                           dialog_sl account (ADR-015). REQUIRED for the
#                           /test_session (deterministic ft) flow.
EVINA_AUTH_MODE=v1-signature

EVINA_USERNAME=replace-with-your-evina-username
EVINA_PASSWORD=replace-with-your-evina-signature-secret
# EVINA_API_KEY is optional in v1-signature mode.
EVINA_API_KEY=

EVINA_BASE_URL=https://api.dcbprotect.com
EVINA_DEFAULT_COUNTRY=LK
EVINA_DEFAULT_CARRIER=41302

# Demo server port (optional).
PORT=4000

# Deterministic fraud demo (optional): force an ft on the next /check via
# /v1/test_session (requires EVINA_AUTH_MODE=v1-signature).
#   1000 -> authentic (allow)   2100 -> code injection (block)
DEMO_FORCE_FT=
